# AGI AI Sales Trainer — backend environment
# Copy to .env and fill in. NEVER commit the filled file.

NODE_ENV=development
PORT=4100

# Shared Postgres (same instance as Sales Analytics; trainer_* schema only)
DATABASE_URL=postgresql://orimax:orimax_dev_password@localhost:5432/sirup

CORS_ORIGIN=http://localhost:3000

# MUST match the Sales Analytics JWT_SECRET so one login works on both services.
JWT_SECRET=change-me-to-match-analytics-jwt-secret

# System-to-system auth for the Sales Analytics training contract.
TRAINER_API_KEY=
ANALYTICS_CALLBACK_URL=

# AI provider (overridable at runtime from the shared filter_config store)
AI_BASE_URL=https://9router.orimax.co.id/v1
AI_API_KEY=
AI_MODEL=cbai/deepseek-v4.1-flash
AI_MODEL_EVAL=cbai/deepseek-v4.1-flash

# STT — Groq whisper (Indonesian)
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3
STT_LANGUAGE=id

# TTS — edge-tts (free). id-ID-ArdiNeural (male) | id-ID-GadisNeural (female)
TTS_VOICE=id-ID-GadisNeural
TTS_RATE=+8%
